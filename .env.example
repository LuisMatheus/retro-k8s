# Shared ROM library root. Each console keeps its ROMs in a subdirectory.
GAMES_DIR=/absolute/path/to/roms
# ROM_DIR is a legacy alias accepted by the scripts.
# Legacy static SNES pilot only; operator sessions set spec.rom in YAML.
SNES_ROM=super-mario-world.sfc
# Match your host user: id -u; id -g
PUID=1000
PGID=1000
# Host input group: getent group input
INPUT_GID=
# Generate with: openssl rand -hex 32
INPUT_TOKEN_SECRET=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SHOW_FPS=false
LOG_LEVEL=INFO
MIN_HOLD_MS=40
