# ROM filenames relative to ~/Documents/games/{snes,gba}/.
SNES_ROM=super-mario-world.sfc
GBA_ROM=pokemon-emerald.gba
# Match your host user: id -u; id -g
PUID=1000
PGID=1000
# Host input group: getent group input
INPUT_GID=
# Generate with: openssl rand -hex 32
INPUT_TOKEN_SECRET=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SHOW_FPS=false
LOG_LEVEL=INFO
MIN_HOLD_MS=40

# For LAN access, set the server LAN IP in both settings.
BIND_ADDRESS=127.0.0.1
WEBRTC_ADDITIONAL_HOSTS=127.0.0.1
